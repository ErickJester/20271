<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <!-- required=false: así la app puede instalarse y mostrarse también en el emulador,
         que no trae hardware NFC; en tiempo de ejecución se valida con NfcAdapter.getDefaultAdapter(). -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nfc">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden">
            <!-- Hace que la app sea iniciable desde el launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Hace que la app se abra sola al detectar una etiqueta NDEF con URI http(s)
                 que apunte al host indicado (autoinicio, Parte 3 de la guía). -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="" />
                <data android:scheme="http" android:host="www.google.com" android:pathPrefix="" />
            </intent-filter>
        </activity>
    </application>

</manifest>
