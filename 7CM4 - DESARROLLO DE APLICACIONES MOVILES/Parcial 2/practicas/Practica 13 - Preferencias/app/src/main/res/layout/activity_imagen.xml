<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nombre_alumno"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/bElegir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Elegir imagen de la galería" />

    <Button
        android:id="@+id/bMostrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostrar en Canvas" />

    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Aún no hay imagen guardada." />

    <ImageView
        android:id="@+id/ivVista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Vista de la imagen guardada"
        android:scaleType="fitCenter" />
</LinearLayout>
</FrameLayout>
