        </activity>
        <activity android:name=".Ejemplo1Activity" android:label="Ejemplo 1" />
        <activity android:name=".CoordenadasActivity" android:label="Ejercicio 1" />
        <activity android:name=".MostrarCoordenadasActivity" android:label="Coordenadas guardadas" />
        <activity android:name=".ImagenActivity" android:label="Ejercicio 2" />
        <activity android:name=".MostrarImagenActivity" android:label="Imagen guardada" />
