<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No se declara CAMERA ni WRITE_EXTERNAL_STORAGE: la foto la toma la app de cámara del
        sistema (Intent) y se guarda con MediaStore. Declarar CAMERA sin pedirla en tiempo de
        ejecución haría fallar el Intent con SecurityException.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Camara">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Ejemplo1Activity" android:label="@string/ejemplo1" />
        <activity android:name=".Ejemplo2Activity" android:label="@string/ejemplo2" />
        <activity android:name=".CamaraComposeActivity" android:label="@string/ejercicio" />
    </application>

</manifest>
